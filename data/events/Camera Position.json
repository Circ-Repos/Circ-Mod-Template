{
  "params": [
    {
      "name": "X Position\nSet value to \"middle\" to position camera between BF and Dad!",
      "type": "String",
      "defaultValue": "0"
    },
    {
      "name": "Y Position\nnSet value to \"middle\" to position camera between BF and Dad!",
      "type": "String",
      "defaultValue": "0"
    },
    {
      "name": "Tween Time (Steps/Seconds, IF NOT CLASSIC)",
      "type": "Float(0.05, 9999, 0.05, 2)",
