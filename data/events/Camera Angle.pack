Camera Angle.hx________PACKSEP________function onEvent(e) {
    if (e.event.name != "Camera Angle") return;

    var cam:FlxCamera = Reflect.field(this, e.event.params[2]);
    var name = (e.event.params[2] == "camHUD" ? "camHUD" : "camGame") + ".angle";

    var tween = eventsTween.get(name);
    tween?.cancel();

    var finalAngle:Float = e.event.params[1];
    if (e.event.params[7] == true) finalAngle *= cam.angle;

    if (e.event.params[0] == false) cam.angle = finalAngle;
    else eventsTween.set(name, FlxTween.tween(cam, {angle: finalAngle}, (Conductor.stepCrochet * 0.001) * e.event.params[3], {ease: CoolUtil.flxeaseFromString(e.event.params[4], e.event.params[5])}));
}________PACKSEP________{
    "params": [
        {
            "name": "Tween Angle?",
            "type": "Bool",
            "defaultValue": true,
            "saveIfDefault": false
        },
        {
            "name": "New Angle",
            "type": "Float(-359, 359, 0.01, 2)",
            "defaultValue": 0
        },
        {
            "name": "Camera",
            "type": "DropDown('camGame', 'camHUD')",
            "defaultValue": "camGame"
        },
        {
            "name": "Tween Time (Steps)",
            "type": "Float(0.25, 9999, 0.25, 2)",
            "defaultValue": 4,
            "saveIfDefault": false
        },
        {
            "name": "Tween Ease (ex: circ, quad, cube)",
            "type": "DropDown('linear', 'back', 'bounce', 'circ', 'cube', 'elastic', 'expo', 'quad', 'quart', 'quint', 'sine', 'smoothStep', 'smootherStep')",
            "defaultValue": "linear",
            "saveIfDefault": false
        },
        {
            "name": "Tween Type (excluded if linear, ex: InOut)",
            "type": "DropDown('In', 'Out', 'InOut')",
            "defaultValue": "In",
            "saveIfDefault": false
        },
        {
            "name": "Multiplicative?",
            "type": "Bool",
            "defaultValue": false
        }
    ]
}________PACKSEP________