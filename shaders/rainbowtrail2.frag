float bitget(int n, int b) {
  return float((n >> b) & 1);      
}

vec4 sega(in vec2 uv) {
  const vec2 size = vec2(80.0, 25.0);
  int bit = int(uv.y * size.y);
  int xx = int(ceil(uv.x * size.x));
  float white = 0.0, blue = 0.0;
  if (bit >= 0 && bit <= 25 && xx >= 0 && xx < 80) {
    white = bitget(img_sega_bp1[xx], bit);
    blue = bitget(img_sega_bp2[xx], bit)*0.7803;
  }
  return vec4(white*0.7803, white*0.7686, white*0.7803 + blue*0.7803, 1.0);
}

vec4 mastersystem(in vec2 uv) {
  const vec2 size = vec2(179.0, 18.0);
  int bit = int(ceil(uv.y * size.y));
  int xx = int(uv.x * size.x);
  float white = 0.0, blue = 0.0;
  if (bit >= 0 && bit <= 25 && xx >= 0 && xx < 179) {
    white = bitget(img_ms_bp1[xx], bit);
    blue = bitget(img_ms_bp2[xx], bit)*0.7803;
  }
  return vec4(white*0.7803, white*0.7686 + blue*0.2549, white*0.7803 + blue*0.7803, 1.0);
}

vec4 logo(in vec2 uv) {
  vec2 size = vec2(179, 50);
  vec2 size1 = vec2(80, 25);
  vec2 size2 = vec2(179, 18);
  vec2 uv0 = uv * size;
  vec2 uv1 = uv0 - vec2(48, 0);
  vec2 uv2 = uv0 - vec2(0, 33);
  vec4 c = sega(uv1 / size1) + mastersystem(uv2 / size2);
  c.w = 1.0;
  return c;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 uv = fragCoord.xy / iResolution.xy;
  fragColor = logo(uv);
}


void main() {
	mainImage(gl_FragColor, openfl_TextureCoordv*openfl_TextureSize);
}